###### reload ######

super + Escape
    pkill -USR1 -x sxhkd ; notify-send "SXHKD Reloaded"

###### Window Manegment ########

# set the window state
super + {t,shift + t}
	bspc node -t {tiled,pseudo_tiled}
super + {s,s}
    bspc node -t {floating,tiled}
super + {f,f}
    bspc node -t {fullscreen,tiled}

# set the node flags
super + ctrl + {1,2,3,4}
	bspc node -g {marked,locked,sticky,private}

# alternate between the tiled and monocle layout
super + m
	bspc desktop -l next

# send the newest marked node to the newest preselected node
super + -
	bspc node newest.marked.local -n newest.!automatic.local

# swap the current node and the biggest window
super + alt + return
	bspc node -s biggest.window


####### Preselect [also knowms as shit I never use] ########

# preselect the direction
super + ctrl + {h,k,j,l}
	bspc node -p {west,south,north,east}

# preselect the ratio
super + ctrl + shift + {1-9}
	bspc node -o 0.{1-9}

# cancel the preselection for the focused node
super + ctrl + space
	bspc node -p cancel

# cancel the preselection for the focused desktop
super + ctrl + shift + space
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel


#### Focus/Swap ####   

# focus the node in the given direction
super + {_,shift + }{h,k,j,l}
	bspc node -{f,s} {west,south,north,east}

# focus the older or newer node in the focus history
super + {o,i}
	bspc wm -h off; \
	bspc node {older,newer} -f; \
	bspc wm -h on

# focus the next/previous window in the current desktop
super + {_,shift + }p
	bspc node -f {next,prev}.local.!hidden.window

# focus the next/previous desktop in the current monitor
super + bracket{left,right}
	bspc desktop -f {prev,next}.local

# focus the last node/desktop
super + {grave,Tab}
	bspc {node,desktop} -f last

# focus or send to the given desktop
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}'


##### Resize/Move ##########
   
# expand a window by moving one of its side outward
super + alt + {h,j,k,l}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# contract a window by moving one of its side inward
super + alt + shift + {h,j,k,l}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# move a floating window
super + shift + {h,j,k,l}
	bspc node -v {-20 0,0 20,0 -20,20 0}


####### Kill/Quit ########

# quit/restart bspwm
super + alt + {q,r}
	bspc {quit,wm -r}

# Powermenu
super + shift + q
     ~/.config/rofi/powermenu/powermenu.sh

# close and kill
super + q
	bspc node -{c,k}

############ Rofi/Launcher #############

super + space
       rofi -show drun 

super + alt + a
       rofi -show filebrowser -config ~/.config/rofi/file.rasi

alt + Tab													
      rofi -show window -config ~/.config/rofi/config-window.rasi

ctrl + super + v
      rofi -modi "clipboard:greenclip print" -show clipboard -config ~/.config/rofi/clip.rasi  -run-command '{cmd}'

super + period
      rofi -modi emoji -show emoji -emoji-mode insert -config ~/.config/rofi/emoji.rasi         


##### ScreenShot ######

Print
    maim -m 10 ~/Pictures/ss/$(date).png && notify-send 'maim' 'fullscreeen shot saved' -t 900

shift + Print
   maim -u -m 10 -s | xclip -selection clipboard -t image/png && notify-send 'maim' 'partial shot copied to clipbaord' -t 900

super + shift + Print
   maim -u -m 10 -s ~/Pictures/ss/$(date).png && notify-send 'maim' 'partial shot saved' -t 900

alt + Print
   maim -m 10 -st 9999999 ~/Pictures/ss/$(date).png && & notify-send 'maim' 'app window saved' -t 900

super + alt + Print
   maim -m 10 -st 9999999  | xclip -selection clipboard -target image/png && notify-send 'maim' 'app window copied' -t 900


########### vol ##########

super + Up
   pamixer -i 5 && volume-notif

super + Down
   pamixer -d 5  && volume-notif

super + alt + Up
   brightnessctl s +5% && brightness-notif

super + alt + Down
   brightnessctl s 5%- && brightness-notif

